# Deterministic install policy for CI (`npm ci`) and MilesWeb production.
#
# WHY legacy-peer-deps:
#   @tanstack/zod-adapter@1.167.0 (latest published) declares
#   peerDependencies.zod = "^3.23.8", while this project depends on zod ^4.4.3
#   (required by the `ai` / @ai-sdk/* stack, which peers on "^3.25.76 || ^4.1.8").
#   npm >= 7 treats that as a hard ERESOLVE failure, so `npm ci` aborts BEFORE
#   node_modules is written — which is what produced
#   "vite: command not found" / exit code 127 in GitHub Actions.
#   Bun (Lovable sandbox) ignores peer conflicts, so the mismatch was invisible
#   locally.
#
#   zod-adapter only uses the standard-schema `parse` surface, which is
#   identical in zod 4, so the declared peer range is stale rather than a real
#   incompatibility. Remove this flag once a zod-4-compatible
#   @tanstack/zod-adapter is published.
legacy-peer-deps=true

# Reproducible, quiet CI installs.
fund=false
audit=false
