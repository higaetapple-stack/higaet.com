# HIGAET — Environment variables (frontend)
# Copy to .env.local for local dev. Production values set in hosting platform.

# Canonical site URL — used for sitemap, canonical, og:url
VITE_SITE_URL=https://higaet.com

# Public contact email (rendered in footer / contact CTAs)
VITE_CONTACT_EMAIL=hello@higaet.com

# Analytics — all optional, app degrades gracefully if absent
VITE_GA4_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=
VITE_CLARITY_ID=
VITE_LINKEDIN_PARTNER_ID=
VITE_GSC_VERIFICATION=

# Future Node.js + Express API base
VITE_API_BASE_URL=

# Lovable Cloud (auto-managed — do not edit)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_PROJECT_ID=
