# ─────────────────────────────────────────────────────────────────────────────
# HIGAET — environment variables
#
# Canonical production runtime: Node.js 22 SSR (Nitro node-server) on
# MilesWeb cPanel + Passenger. Cloudflare Workers is NOT a production target.
#
# Three distinct scopes — do not mix them:
#   [CLIENT]  VITE_*  → inlined into the browser bundle at BUILD time.
#                       Must be identical in CI (build) and on the host.
#                       NEVER put a secret behind a VITE_ prefix.
#   [SERVER]  unprefixed → read at RUNTIME inside server functions / app.js.
#                       Set in cPanel → Setup Node.js App → Environment variables.
#   [CI]      unprefixed → set only as GitHub Actions secrets; never on the host.
#
# Copy to .env.local for local development. Production values are configured
# in cPanel, not in this file.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# 1. PRODUCTION — REQUIRED (app.js refuses to boot without these)
# ═════════════════════════════════════════════════════════════════════════════

# [SERVER] Backend connection used by SSR and server functions.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# [SERVER] Privileged key — server only. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# [SERVER] Random 32+ char string. Generate with: openssl rand -hex 32
SESSION_SECRET=

# [CLIENT] Must mirror SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY exactly.
# Baked into the browser bundle at build time — set these in CI as well.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=


# ═════════════════════════════════════════════════════════════════════════════
# 2. PRODUCTION — SITE IDENTITY
# ═════════════════════════════════════════════════════════════════════════════

# [CLIENT] Canonical site URL — used for sitemap, canonical links, og:url.
VITE_SITE_URL=https://higaet.com

# [CLIENT] Public contact email rendered in footer / contact CTAs.
VITE_CONTACT_EMAIL=hello@higaet.com

# [CLIENT] Future Node.js API base (optional).
VITE_API_BASE_URL=


# ═════════════════════════════════════════════════════════════════════════════
# 3. PRODUCTION — OPTIONAL FEATURE FLAGS (absent = feature disabled)
# ═════════════════════════════════════════════════════════════════════════════

# [SERVER] Transactional email.
BREVO_API_KEY=

# [SERVER] Payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# [SERVER] AI providers.
LOVABLE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# [CLIENT] Error monitoring — DSN is publishable.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=production

# [CLIENT] Analytics — all optional, the app degrades gracefully if absent.
VITE_GA4_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=
VITE_CLARITY_ID=
VITE_LINKEDIN_PARTNER_ID=
VITE_GSC_VERIFICATION=

# [CLIENT] Product analytics — PostHog (host defaults to EU).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com


# ═════════════════════════════════════════════════════════════════════════════
# 4. CI-ONLY — GitHub Actions secrets. Do NOT set these on the MilesWeb host.
# ═════════════════════════════════════════════════════════════════════════════

# Deployment transport (GitHub → MilesWeb over SSH).
#   SSH_KEY, SSH_HOST, SSH_USER, SSH_PORT  → environment secrets
#   DEPLOY_DIR                             → environment variable (vars.*)

# Sentry sourcemap upload + AI SRE commit attribution.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=higaet-5y
# SENTRY_PROJECT=javascript-react
# GIT_COMMIT_SHA=


# ═════════════════════════════════════════════════════════════════════════════
# 5. DEVELOPMENT-ONLY — never set in production
# ═════════════════════════════════════════════════════════════════════════════

# Set by the Lovable preview sandbox. If either is present during a Node build,
# the Lovable Vite wrapper forces the Cloudflare preset and .output/server/
# index.mjs is never emitted. `npm run build:node` clears them automatically.
# LOVABLE_SANDBOX=
# DEV_SERVER__PROJECT_PATH=

# Bypasses app.js strict env validation. Local debugging only — NEVER in prod.
# STRICT_ENV=0
